# Consistent cross-platform line endings
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.tex  text eol=lf
*.sh   text eol=lf

*.bat  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.db   binary
*.sqlite3 binary
